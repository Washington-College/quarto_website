{
  "name": "Intro to Data Science Portfolio - Quarto & R",
  "image": "ghcr.io/rocker-org/devcontainer/tidyverse:4",
  "features": {
    "ghcr.io/rocker-org/devcontainer-features/quarto-cli:1": {
      "version": "release"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "quarto.quarto",
        "REditorSupport.r"
      ],
      "settings": {
        "r.alwaysUseActiveTerminal": true,
        "r.bracketedPaste": true,
        "git.autofetch": true,
        "git.confirmSync": false,
        "githubPullRequests.ignoredPullRequestBranches": [
          "main"
        ],
        "githubPullRequests.showInitialNotification": false
      }
    }
  },
  "postCreateCommand": "bash -c 'Rscript install_packages.R && quarto check'"
}
